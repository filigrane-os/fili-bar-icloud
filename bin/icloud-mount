#!/bin/bash
# iCloud Drive mounted in ~/iCloud (rclone mount): files downloaded on opening, local cache capped at 5 GB
# (the least recently used go first). Tree read in the background at mount and kept for 1 h
# (iCloud does not signal changes: an addition from the Mac/iPhone can take up to 1 h to appear).
# Started by niri at login, waits for the network.
# Config OUTSIDE the repository (Apple credentials): remote "icloud" created by `rclone config` (type iclouddrive, 2FA).
# Apple session valid for 30 days: reminder by watch-icloud (cron-watch) and button to icloud-reconnect.
. "$(dirname "$(readlink -f "$0")")/opt.sh"
REMOTE="$(opt remote icloud:)"
MNT="$(opt mountpoint "$HOME/iCloud")"
STATE="$HOME/.local/state/icloud"
mkdir -p "$STATE" "$MNT"

rclone listremotes 2>/dev/null | grep -qx "$REMOTE" || exit 0
mountpoint -q "$MNT" && exit 0
fusermount3 -uz "$MNT" 2>/dev/null  # dead mount of a previous session
# Written outside the mount (via ~/Documents or ~/Pictures): rclone would refuse a non-empty mount point
if [ -n "$(ls -A "$MNT")" ]; then
    aside="$STATE/hors-montage-$(date +%Y%m%d%H%M%S)"
    mv "$MNT" "$aside" && mkdir -p "$MNT"
    notify-send -a icloud "iCloud: files written outside the mount" "Set aside in $aside"
fi

until timeout 3 bash -c 'exec 3<>/dev/tcp/www.icloud.com/443' 2>/dev/null; do sleep 30; done

# Go heap kept small (rclone idles around 90 MB otherwise): soft limit + eager GC, 4 MB read buffer per open file
GOMEMLIMIT=48MiB GOGC=40 rclone mount "$REMOTE" "$MNT" \
    --buffer-size 4M --use-mmap \
    --vfs-cache-mode full --vfs-cache-max-size 5G --vfs-cache-max-age 720h \
    --dir-cache-time 1h --poll-interval 0 --vfs-refresh \
    --log-level NOTICE --log-file "$STATE/mount.log" && exit 0
[ "$(notify-send -u critical -a icloud -A reconnect=Reconnect "iCloud not mounted" \
    "$(grep -m1 -iE 'reconnect|auth|error' "$STATE/mount.log" | tail -c 200)")" = reconnect ] &&
    "$HOME/.local/bin/bar-tui" "$(dirname "$(readlink -f "$0")")/icloud-reconnect"
exit 1
